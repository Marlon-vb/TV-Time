{
  "expo": {
    "name": "TV Time",
    "slug": "tv-time",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tvtime",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0c14",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0c14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tvtime.personal",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.tvtime.personal"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "TV Time can match your contacts to help you find friends who already use the app. Your contacts are hashed on your device and never uploaded in readable form.",
        "NSPhotoLibraryUsageDescription": "TV Time lets you attach a photo to your episode comments."
      }
    },
    "android": {
      "package": "app.tvtime.personal",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-background-task",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "TV Time matches your contacts to help you find friends who already use the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#fbd737"
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "supabaseUrl": "https://dvrnfqyrljcuosjspyab.supabase.co",
      "supabaseKey": "sb_publishable_ew2E-UCvJjbWdbA7U5_X3g_2emZRWyL",
      "eas": {
        "projectId": "c931a518-a108-4e69-a05f-b637eee28372"
      }
    },
    "owner": "marlonvb"
  }
}
