{
  "expo": {
    "name": "TV App",
    "slug": "tv-time",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tvtime",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0c14",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0c14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.tvtime.personal",
      "appleTeamId": "2RKZ63T7G7",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.tvtime.personal"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "TV App matches the email addresses in your contacts to help you find friends who already use the app. Addresses are hashed on your device and only those hashes are sent, so nothing readable leaves your phone. Phone numbers are never read.",
        "NSPhotoLibraryUsageDescription": "TV App lets you attach a photo to your episode comments."
      }
    },
    "android": {
      "package": "app.tvtime.personal",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-background-task",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "TV App matches the email addresses in your contacts to help you find friends who already use the app. Addresses are hashed on your device and only those hashes are sent, so nothing readable leaves your phone. Phone numbers are never read."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TV App lets you attach a photo to your episode comments.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#fbd737"
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "supabaseUrl": "https://dvrnfqyrljcuosjspyab.supabase.co",
      "supabaseKey": "sb_publishable_ew2E-UCvJjbWdbA7U5_X3g_2emZRWyL",
      "eas": {
        "projectId": "c931a518-a108-4e69-a05f-b637eee28372"
      }
    },
    "owner": "marlonvb"
  }
}
